@model Storefront.ViewModels.ProductCardViewModel
@{
    var isSoldOut = Model.StockQuantity <= 0;
}

<article class="card storefront-card h-100 @(isSoldOut ? "sold-out" : "")">
    <!-- 1. Product Image -->
    <div class="storefront-card-img-wrap position-relative">
        @if (isSoldOut)
        {
            <div class="sold-out-ribbon" aria-label="Sold Out">Sold Out</div>
        }

        <a asp-page="/ProductDetail" asp-route-slug="@Model.Slug" aria-label="View @Model.Name">
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="card-img-top storefront-card-img"
                 loading="lazy" />
        </a>
    </div>

    <div class="card-body d-flex flex-column p-3">
        <!-- 2. Product Name -->
        <h2 class="storefront-card-title mb-1">
            <a asp-page="/ProductDetail" asp-route-slug="@Model.Slug" class="text-decoration-none text-reset">
                @Model.Name
            </a>
        </h2>

        <!-- 3. Price -->
        <div class="storefront-card-price mb-2">
            @Model.Price.ToString("C")
        </div>

        <!-- 4. Metadata Badges -->
        <div class="d-flex flex-wrap gap-1 mb-2">
            <span class="badge storefront-badge badge-audience">@Model.AudienceLabel</span>
            <span class="badge storefront-badge badge-category">@Model.CategoryName</span>
            <span class="badge storefront-badge @Model.ConditionBadgeCss">@Model.ConditionLabel</span>
        </div>

        <!-- 5. Secondary Metadata (Colour, Size, Stock) -->
        <div class="storefront-card-meta d-flex flex-wrap align-items-center mb-3">
            <span class="d-inline-flex align-items-center gap-1">
                <span class="text-muted">Colour:</span>
                <span class="colour-swatch" style="background-color: @Model.ColourHex;" aria-hidden="true"></span>
                <span class="fw-medium">@Model.ColourName</span>
            </span>

            @if (!string.IsNullOrWhiteSpace(Model.Size))
            {
                <span>
                    <span class="text-muted">Size:</span>
                    <span class="fw-medium">@Model.Size</span>
                </span>
            }

            <span>
                <span class="text-muted">Stock:</span>
                @if (!isSoldOut)
                {
                    <span class="fw-medium">@Model.StockQuantity available</span>
                }
                else
                {
                    <span class="fw-semibold text-danger">Sold out</span>
                }
            </span>
        </div>

        <!-- 6. View Details Button -->
        <div class="mt-auto">
            @if (!isSoldOut)
            {
                <a asp-page="/ProductDetail"
                   asp-route-slug="@Model.Slug"
                   class="btn btn-bronze w-100">
                    View Details
                </a>
            }
            else
            {
                <a asp-page="/ProductDetail"
                   asp-route-slug="@Model.Slug"
                   class="btn btn-outline-secondary w-100">
                    View Details (Sold)
                </a>
            }
        </div>
    </div>
</article>